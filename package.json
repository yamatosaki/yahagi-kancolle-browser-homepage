{
  "name": "yahagi-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm test && npm run build && gh-pages -d dist --nojekyll --cname yahagi.xyz -m \"chore(部署): 更新官网静态文件\"",
    "sync:releases": "node scripts/sync-releases.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "gh-pages": "6.1.1",
    "vite": "8.3.4"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.1"
  }
}
